pipeline {

    agent {
        label 'myslave'
    }

    environment {
        DOCKERHUB_CREDENTIALS = credentials('dockerhub-creds')
    }

    stages {

        stage('Cleanup Old Containers and Images') {
            steps {
                sh '''
                docker rm -f auth-container product-container order-container || true
                docker rmi -f auth-service:v1 product-service:v1 order-service:v1 || true
                docker rmi -f $DOCKERHUB_CREDENTIALS_USR/auth-service:v1 || true
                docker rmi -f $DOCKERHUB_CREDENTIALS_USR/product-service:v1 || true
                docker rmi -f $DOCKERHUB_CREDENTIALS_USR/order-service:v1 || true
                '''
            }
        }

        stage('Build Docker Images') {
            steps {
                sh '''
                docker build -t auth-service:v1 ./auth-service
                docker build -t product-service:v1 ./product-service
                docker build -t order-service:v1 ./order-service
                '''
            }
        }

        stage('Docker Hub Login') {
            steps {
                sh '''
                echo $DOCKERHUB_CREDENTIALS_PSW | docker login -u $DOCKERHUB_CREDENTIALS_USR --password-stdin
                '''
            }
        }

        stage('Tag Docker Images') {
            steps {
                sh '''
                docker tag auth-service:v1 $DOCKERHUB_CREDENTIALS_USR/auth-service:v1
                docker tag product-service:v1 $DOCKERHUB_CREDENTIALS_USR/product-service:v1
                docker tag order-service:v1 $DOCKERHUB_CREDENTIALS_USR/order-service:v1
                '''
            }
        }

        stage('Push Images to Docker Hub') {
            steps {
                sh '''
                docker push $DOCKERHUB_CREDENTIALS_USR/auth-service:v1
                docker push $DOCKERHUB_CREDENTIALS_USR/product-service:v1
                docker push $DOCKERHUB_CREDENTIALS_USR/order-service:v1
                '''
            }
        }

        stage('Verify Docker Images') {
            steps {
                sh 'docker images'
            }
        }
        stage('Deploy to minikube') {
            steps {

                sh 'kubectl apply -f minikube/'

                sh 'kubectl get deployments'

                sh 'kubectl get pods'
            }
        }
    }
}
        

